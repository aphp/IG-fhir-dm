/// url = 'https://aphp.github.io/IG-fhir-dm/StructureMap/MedAdminMap'
/// name = 'MedAdminMap'
/// title = 'Mapping MedicationAdministration to DrugExposure OMOP Domain'
/// status = 'active'
/// description = "This mapping maps FHIR MedicationAdministration instances to OMOP Drug Exposure Table objects."

uses "http://hl7.org/fhir/StructureDefinition/MedicationAdministration" alias MedAdmin as source
uses "https://aphp.github.io/IG-fhir-dm/StructureDefinition/OMOPDrugExposure" alias DrugExpTable as target

group MedAdminExposure(source src : MedAdmin, target tgt : DrugExpTable) {
	src as s -> tgt then {
		s.id as id -> tgt.drug_exposure_id = id;
	} "medAdminID";

	src.subject as subject -> tgt then {
		subject.reference as s -> tgt.person_id = create('Reference') as ref then {
			s as refVal -> ref.reference = refVal "personRefValRule";
		} "personRefRule";
	};

	src.medication : CodeableConcept as s -> tgt then {
		s.coding as sc -> tgt then {
			sc.code as a -> tgt.drug_source_value = a "drugSourceValueRule";
		};
	};

	src.effective : Period as s -> tgt then {
		s.start as fps -> tgt.drug_exposure_start_datetime = fps, tgt.drug_exposure_start_date = (%fps.toString().substring(0, 10)) "effectiveStartRule";
		s.end as fpe -> tgt.drug_exposure_end_datetime = fpe, tgt.drug_exposure_end_date = (%fpe.toString().substring(0, 10)) "effectiveEndRule";
	};

	src.dosage as d -> tgt then {
		d.route as r -> tgt then {
			r.coding as rc -> tgt then {
				rc.code as a -> tgt.route_source_value = a "routeSourceValueRule";
			};
		};
		d.dose as dose -> tgt then {
			dose.value as v -> tgt.quantity = v "doseValueRule";
			dose.unit as u -> tgt.dose_unit_source_value = u "doseUnitRule";
		};
	};

	src -> tgt.drug_type_concept_id = create('Reference') as ref2 then {
		src -> ref2.reference = '38000180' "typeAdminRefValRule";
	} "typeAdminRefRule";
}
