/// url = 'https://aphp.github.io/IG-fhir-dm/StructureMap/EncounterVisitMap'
/// name = 'EncounterVisitMap'
/// title = 'Mapping Encounter resource to VisitOccurrence OMOP Domain'
/// status = 'active'
/// description = "This mapping maps FHIR Encounter instances to OMOP Visit Occurence Table objects."

uses "http://hl7.org/fhir/StructureDefinition/Encounter" alias Encounter as source
uses "https://aphp.github.io/IG-fhir-dm/StructureDefinition/OMOPVisitOccurrence" alias VisitTable as target

group VisitOccurrence(source src: Encounter, target tgt : VisitTable) {

	// OMOP Visit Occurrence ID would be a map from FHIR ID to an external key
	src as s -> tgt then {
		s.id as id -> tgt.visit_occurrence_id = id;
	} "encounterID";

	// OMOP Person ID would be a map from the FHIR Encounter Subject reference to an external key
	src.subject as subject -> tgt then {
		subject.reference as s -> tgt.person_id = (%s.substring(%s.indexOf('/') + 1));
	};

	src.class as s -> tgt then {
		s.code as code -> tgt.visit_concept_id = translate(code, 'https://aphp.github.io/IG-fhir-dm/ConceptMap/EncounterClass', 'code'), tgt.visit_source_value = code "classCodeRule";
	} "classRule";

	src.period as s -> tgt then {
		s.start as std -> tgt.visit_start_date = (%std.toString().substring(0,10)), tgt.visit_start_datetime = std "startRule";
		s.end as ed -> tgt.visit_end_date = (%ed.toString().substring(0,10)), tgt.visit_end_datetime = ed "endRule";
	};

	src.hospitalization as s -> tgt then {
		s.admitSource as sa -> tgt then {
			sa.coding as sc -> tgt then {
				sc.code as code -> tgt.admitted_from_concept_id = translate(code, 'https://aphp.github.io/IG-fhir-dm/ConceptMap/EncounterAdmitSource', 'code'), tgt.admitted_from_source_value = code "admitSourceRule";
			};
		};

		s.dischargeDisposition as sd -> tgt then {
			sd.coding as sc -> tgt then {
				sc.code as code -> tgt.discharged_to_concept_id = translate(code, 'https://aphp.github.io/IG-fhir-dm/ConceptMap/EncounterDischargeDisposition', 'code'), tgt.discharged_to_source_value = code "dischargeRule";
			};
		};
	};

}
